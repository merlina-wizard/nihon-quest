rules_version = '2';

// Nihon Quest — ogni viaggio vive sotto /trips/{codice}/…
// Il codice segreto è la chiave: le regole non permettono di elencare i viaggi,
// quindi chi non conosce il codice non può né trovarlo né leggerne i dati.
service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{trip}/{coll}/{docId} {
      function allowed() {
        return request.auth != null
          && trip.size() >= 12
          && coll in ['days', 'stops', 'expenses', 'bookings', 'meta', 'photos'];
      }
      // Le foto (scontrini, biglietti) sono JPEG compressi in base64: massimo ~900 KB di testo.
      function photoOk() {
        return coll != 'photos'
          || (request.resource.data.data is string && request.resource.data.data.size() < 900000);
      }
      allow read, delete: if allowed();
      allow create, update: if allowed() && request.resource.data.size() < 200 && photoOk();
    }

    // Tutto il resto è chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
